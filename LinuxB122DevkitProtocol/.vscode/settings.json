{
    "files.associations": {
        "*.c": "c",
        "*.h": "c"
    },
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.defines": [
        "_DEFAULT_SOURCE",
        "_BSD_SOURCE"
    ],
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
