{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug BT122 Monitor (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bt122_monitor",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug",
            "condition": "os.platform() == 'linux'"
        },
        {
            "name": "Debug BT122 Monitor (Windows MSVC)",
