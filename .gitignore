# ------------------------------------------------------------------------------
# Atmel Studio 7 .gitignore (recursive-safe)
# ------------------------------------------------------------------------------

# Build output directories (recursively)
[Bb]uild*/
[Dd]ebug*/
[Rr]elease*/
Output*/
Obj*/
Bin*/

# Ignore all intermediate and build artifacts anywhere
**/*.obj
**/*.o
**/*.d
**/*.dmp
**/*.elf
**/*.map
**/*.eep
**/*.lss
**/*.hex
**/*.bin
**/*.srec
**/*.tmp
**/*.dep
**/*.pdb
**/*.idb

# Atmel Studio–specific user and temp files
**/*.asuser
**/*.asdb
**/*.atsuo
**/*.atsln.user
**/*.atsln.suo
**/*.asproj.user
**/*.cproj.user
**/*.componentinfo.xml

# Visual Studio infrastructure (Atmel Studio base)
.vs/
**/*.VC.db
**/*.VC.opendb

# Misc IDE and temporary files
**/*.aps
**/*.bak
**/*.log
**/*.ncb
**/*.opendb
**/*.db
**/*.vsp
**/*.tlog
**/*.lastbuildstate
**/*.cachefile
**/*.ipch

# Packages, tools, and auto-generated folders
.packages/
AtmelStudio/
toolchain/

# Backup / autosave / temp
*~
**/*.autosave
**/*.bak
**/*.orig
**/*.old
**/*.tmp
**/*.temp

# OS-specific junk
.DS_Store
Thumbs.db
desktop.ini

# Archives or exports
**/*.zip
**/*.7z
**/*.rar
**/*.tar
**/*.gz

# ------------------------------------------------------------------------------
# Keep essential project & source files
# ------------------------------------------------------------------------------
!.gitignore
!**/*.c
!**/*.cpp
!**/*.h
!**/*.S
!**/*.asm
!**/*.asf
!**/*.txt
!**/*.atsln
!**/*.cproj
!**/*.asproj
!**/*.xml
!README.md
