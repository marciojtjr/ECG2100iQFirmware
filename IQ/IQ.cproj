        <avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>True</avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>
        <avrgcc.compiler.symbols.DefSymbols>
          <ListValues>
            <Value>BOOTLOADER</Value>
            <Value>F_CPU=32000000UL</Value>
            <Value>__AVR_ATxmega64A3U__</Value>
            <Value>__AVR_XMEGA__</Value>
            <Value>WDE=3</Value>
          </ListValues>
        </avrgcc.compiler.symbols.DefSymbols>
        <avrgcc.compiler.optimization.level>Optimize for size (-Os)</avrgcc.compiler.optimization.level>
        <avrgcc.compiler.optimization.PackStructureMembers>True</avrgcc.compiler.optimization.PackStructureMembers>
        <avrgcc.compiler.optimization.AllocateBytesNeededForEnum>True</avrgcc.compiler.optimization.AllocateBytesNeededForEnum>
        <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
        <avrgcc.compiler.miscellaneous.OtherFlags>-mmcu=atxmega64a3u -gdwarf-2 -std=gnu99</avrgcc.compiler.miscellaneous.OtherFlags>
        <avrgcc.linker.memorysettings.Flash>
          <ListValues>
            <Value>.text=0x8000</Value>
          </ListValues>
        </avrgcc.linker.memorysettings.Flash>
        <avrgcc.linker.miscellaneous.LinkerFlags>-mmcu=atxmega64a3u</avrgcc.linker.miscellaneous.LinkerFlags>
        <avrgcc.assembler.general.AssemblerFlags>-mmcu=atxmega64a3u -Wall -gdwarf-2 -std=gnu99 -D__AVR_XMEGA__ -D__AVR_ATxmega64A3U__  -DBOOTLOADER     -DF_CPU=2000000UL -Os -funsigned-char -funsigned-bitfields -fpack-struct -fshort-enums</avrgcc.assembler.general.AssemblerFlags>
      </AvrGcc>
    </ToolchainSettings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'ContinuousBluetooth' ">
    <OutputFileName>iq_continuous_bt</OutputFileName>
    <OutputFileExtension>.elf</OutputFileExtension>
    <OutputPath>bin\ContinuousBluetooth\</OutputPath>
    <ToolchainSettings>
      <AvrGcc xmlns="">
        <avrgcc.common.outputfiles.hex>True</avrgcc.common.outputfiles.hex>
        <avrgcc.common.outputfiles.lss>True</avrgcc.common.outputfiles.lss>
        <avrgcc.common.outputfiles.eep>True</avrgcc.common.outputfiles.eep>
        <avrgcc.common.outputfiles.srec>True</avrgcc.common.outputfiles.srec>
        <avrgcc.common.outputfiles.usersignatures>False</avrgcc.common.outputfiles.usersignatures>
        <avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>True</avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>
        <avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>True</avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>
        <avrgcc.compiler.symbols.DefSymbols>
          <ListValues>
            <Value>BLUETOOTH=1</Value>
            <Value>F_CPU=32000000UL</Value>
            <Value>CONTINUOUS_BT=1</Value>
            <Value>__AVR_ATxmega64A3U__</Value>
            <Value>__AVR_XMEGA__</Value>
            <Value>WDE=3</Value>
          </ListValues>
        </avrgcc.compiler.symbols.DefSymbols>
        <avrgcc.compiler.optimization.level>Optimize for size (-Os)</avrgcc.compiler.optimization.level>
        <avrgcc.compiler.optimization.PackStructureMembers>True</avrgcc.compiler.optimization.PackStructureMembers>
        <avrgcc.compiler.optimization.AllocateBytesNeededForEnum>True</avrgcc.compiler.optimization.AllocateBytesNeededForEnum>
        <avrgcc.compiler.optimization.DebugLevel>Maximum (-g3)</avrgcc.compiler.optimization.DebugLevel>
        <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
        <avrgcc.compiler.miscellaneous.OtherFlags>-mmcu=atxmega64a3u -gdwarf-2 -std=gnu99</avrgcc.compiler.miscellaneous.OtherFlags>
        <avrgcc.linker.libraries.Libraries>
          <ListValues>
            <Value>libprintf_flt.a</Value>
            <Value>libscanf_flt.a</Value>
            <Value>libm</Value>
          </ListValues>
        </avrgcc.linker.libraries.Libraries>
        <avrgcc.linker.miscellaneous.LinkerFlags>-mmcu=atxmega64a3u -Wl,-u,vfscanf -Wl,-u,vfprintf</avrgcc.linker.miscellaneous.LinkerFlags>
        <avrgcc.assembler.general.AssemblerFlags>-mmcu=atxmega64a3u -Wall -gdwarf-2 -std=gnu99 -D__AVR_XMEGA__ -D__AVR_ATxmega64A3U__ -DBLUETOOTH=1        -DF_CPU=32000000UL -Os -funsigned-char -funsigned-bitfields -fpack-struct -fshort-enums -gdwarf-2 -std=gnu99 -DBLUETOOTH=1        -DF_CPU=32000000UL -Os -funsigned-char -funsigned-bitfields -fpack-struct -fshort-enums</avrgcc.assembler.general.AssemblerFlags>
        <avrgcc.assembler.debugging.DebugLevel>Default (-Wa,-g)</avrgcc.assembler.debugging.DebugLevel>
      </AvrGcc>
    </ToolchainSettings>
  </PropertyGroup>
